# Salin ke .env.local untuk guna Supabase di mesin sendiri.
# Di Vercel: Project → Settings → Environment Variables, letak dua nilai yang sama.
# Nama tanpa NEXT_PUBLIC_ supaya ia dibaca pada masa jalan, bukan semasa build.
#
# Dua-dua kunci ini SELAMAT didedahkan ke pelayar (ia direka untuk itu) ASALKAN
# RLS dihidupkan — lihat web/supabase/schema.sql.
SUPABASE_URL=https://PROJECT-REF.supabase.co
SUPABASE_ANON_KEY=eyJhbGciOi...

# Kunci service_role TIDAK diletak di sini. Ia hanya untuk skrip Python pada mesin Adam:
#   SUPABASE_SERVICE_KEY=...  (export di shell, jangan simpan dalam fail repo)
